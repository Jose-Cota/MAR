"[{\"proyecto_id\":1767,\"responsable_operativo_id\":970,\"ejercicio_id\":19,\"subprograma_id\":1,\"numero\":\"01\",\"nombre\":\"Representaci\\u00f3n del Tribunal en los distintos eventos de car\\u00e1cter local, nacional e internacional. Celebrar los convenios institucionales que se requieran; as\\u00ed como realizar los actos administrativos necesarios para el buen funcionamiento del Tribunal.\",\"tipo\":\"normal\",\"version\":1,\"objetivo\":\"\",\"justificacion\":\"\",\"descripcion\":\"El proyecto tiene como prop\\u00f3sito representar al Tribunal en el \\u00e1mbito local, nacional e internacional en materia de impartici\\u00f3n de justicia electoral, a trav\\u00e9s del di\\u00e1logo con diversos organismos p\\u00fablicos y privados, organizaciones de la sociedad civil, entre otros. Las acciones de este proyecto est\\u00e1n orientadas a establecer y consolidar los v\\u00ednculos con los diferentes actores de la sociedad con los cuales el Tribunal fortalece su operaci\\u00f3n, desarrollo, resultados, posicionamiento, imagen y autonom\\u00eda en el \\u00e1mbito de impartici\\u00f3n de justicia electoral. Asimismo, busca fomentar y mantener una adecuada operaci\\u00f3n interna a trav\\u00e9s de la oportuna coordinaci\\u00f3n de las actividades y funciones que desempe\\u00f1a cada unidad administrativa del TECDMX e informar de ello al Pleno.\",\"fecha\":\"2026-09-23\",\"nombre_responsable_operativo\":\"\",\"cargo_responsable_operativo\":\"\",\"nombre_titular\":\"\",\"responsable_ficha\":\"\",\"autorizado_por\":\"\",\"status\":\"abierto\",\"fecha_cierre\":null,\"fecha_verificacion\":null,\"puesto_responsable_ficha\":null,\"autorizante_nombre\":null,\"autorizante_puesto\":null,\"id\":1767,\"urg_id\":565,\"ro_nombre\":\"Magistrado (a) Presidente (a)\",\"riesgos_area\":[{\"id\":1166,\"local_id\":\"R1\",\"riesgo\":\"Que los acuerdos y resoluciones del Pleno no sean atendidos, canalizados o seguidos oportunamente.\"},{\"id\":1167,\"local_id\":\"R2\",\"riesgo\":\"Que las reuniones no cuenten con informaci\\u00f3n, acuerdos o seguimiento suficientes para atender los asuntos institucionales.\"},{\"id\":1168,\"local_id\":\"R3\",\"riesgo\":\"Que la representaci\\u00f3n institucional se realice sin informaci\\u00f3n suficiente, coordinaci\\u00f3n previa o atenci\\u00f3n oportuna de compromisos derivados.\"}],\"metas\":[],\"indicadores\":[],\"acciones\":[{\"accion_sustantiva_id\":16084,\"proyecto_id\":1767,\"numero\":1,\"descripcion\":\"Dar seguimiento al cumplimiento de los acuerdos y resoluciones del Pleno del Tribunal.\",\"recursos_asociados\":null,\"riesgos_vinculados\":[{\"id\":1166,\"local_id\":\"R1\",\"riesgo\":\"Que los acuerdos y resoluciones del Pleno no sean atendidos, canalizados o seguidos oportunamente.\"}]},{\"accion_sustantiva_id\":16085,\"proyecto_id\":1767,\"numero\":2,\"descripcion\":\"Celebrar peri\\u00f3dicamente reuniones de trabajo con las personas titulares de las unidades administrativas, con el objeto de mantener una adecuada coordinaci\\u00f3n y cohesi\\u00f3n institucional.\",\"recursos_asociados\":null,\"riesgos_vinculados\":[{\"id\":1167,\"local_id\":\"R2\",\"riesgo\":\"Que las reuniones no cuenten con informaci\\u00f3n, acuerdos o seguimiento suficientes para atender los asuntos institucionales.\"}]},{\"accion_sustantiva_id\":16086,\"proyecto_id\":1767,\"numero\":3,\"descripcion\":\"Representar oficialmente al Tribunal.\",\"recursos_asociados\":null,\"riesgos_vinculados\":[{\"id\":1168,\"local_id\":\"R3\",\"riesgo\":\"Que la representaci\\u00f3n institucional se realice sin informaci\\u00f3n suficiente, coordinaci\\u00f3n previa o atenci\\u00f3n oportuna de compromisos derivados.\"}]}]}]"
