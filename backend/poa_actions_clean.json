html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sistema MAR TECDMX 7.0</title><style>:root{--navy:#092e55;--blue:#1f4e78;--blue2:#2d75b8;--bg:#f3f6f9;--line:#d9e2ec;--text:#17324d;--muted:#6f8294;--white:#fff;--q1:#f5cccc;--q2:#f6edbb;--q3:#d7ead2;--q4:#d5e8f4;--ok:#2d7d46;--warn:#b7791f;--danger:#ad2e24;--shadow:0 6px 20px rgba(16,52,85,.08)}*{box-sizing:border-box}body{margin:0;font:14px/1.45 "Segoe UI",Arial,sans-serif;color:var(--text);background:var(--bg)}button,input,select,textarea{font:inherit}button{cursor:pointer}.input{width:100%;border:1px solid #cbd6e2;border-radius:7px;background:#fff;padding:9px 10px;color:var(--text)}textarea.input{min-height:76px;resize:vertical}.input.small{width:auto;min-width:90px}.btn{border:1px solid #c8d4df;background:#fff;color:var(--text);border-radius:7px;padding:9px 14px;font-weight:600}.btn:hover{background:#f7f9fb}.btn.primary{background:var(--blue);border-color:var(--blue);color:#fff}.btn.ghost{background:transparent;border-color:#d8e1e9}.btn.full{width:100%}.topbar{height:88px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:10px 24px;position:sticky;top:0;z-index:20}.brand{display:flex;align-items:center;gap:18px}.brand img{width:190px;height:68px;object-fit:contain}.brand div{display:flex;flex-direction:column}.brand b{font-size:20px;color:var(--navy)}.brand span{font-size:13px;color:var(--muted)}.top-actions{display:flex;align-items:center;gap:16px}.top-actions>label{display:flex;align-items:center;gap:8px}.userbox{display:flex;flex-direction:column;border-left:1px solid var(--line);padding-left:16px}.userbox span{font-size:12px;color:var(--muted)}.layout{display:grid;grid-template-columns:230px 1fr;min-height:calc(100vh - 88px)}.sidebar{background:linear-gradient(180deg,#0b3d68,#082d50);padding:18px 12px;color:#fff;display:flex;flex-direction:column;justify-content:space-between}.sidebar nav{display:flex;flex-direction:column;gap:6px}.nav-link{border:0;background:transparent;color:#dbe8f3;padding:12px 14px;border-radius:7px;text-align:left;font-weight:600;display:flex;gap:10px;align-items:center}.nav-link:hover,.nav-link.active{background:#1f5f95;color:#fff}.side-footer{padding:14px;color:#b8cce0;border-top:1px solid rgba(255,255,255,.15)}.content{padding:24px;min-width:0}.page-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin-bottom:18px}.page-head h1{margin:0 0 4px;font-size:28px;color:var(--navy)}.page-head p{margin:0;color:var(--muted)}.head-actions{display:flex;gap:8px;align-items:center}.panel{background:#fff;border:1px solid var(--line);border-radius:10px;box-shadow:var(--shadow);padding:18px;margin-bottom:18px;overflow:auto}.panel h2{font-size:18px;margin:0 0 14px;color:var(--navy)}.panel-head{display:flex;justify-content:space-between;align-items:center}.notice{background:#edf5fb;border-left:5px solid var(--blue2);padding:12px 16px;border-radius:7px;margin:0 0 18px}.kpis{display:grid;grid-template-columns:repeat(5,minmax(130px,1fr));gap:12px;margin-bottom:18px}.kpi{background:#fff;border:1px solid var(--line);border-radius:9px;padding:14px 16px;box-shadow:var(--shadow);display:flex;flex-direction:column}.kpi span{color:var(--muted);font-size:12px}.kpi b{font-size:28px;color:var(--blue)}.grid-2{display:grid;grid-template-columns:1.4fr 1fr;gap:18px}.area-cards{display:grid;grid-template-columns:repeat(2,minmax(240px,1fr));gap:10px}.area-card{text-align:left;border:1px solid var(--line);background:#fbfcfd;border-radius:8px;padding:12px;display:grid;gap:5px}.area-card:hover{border-color:#8eb6d7;background:#f5fafe}.area-card span,.area-card small{color:var(--muted)}.bar{height:7px;background:#e7edf3;border-radius:20px;overflow:hidden}.bar i{height:100%;display:block;background:var(--blue2)}.quadrant-mini{display:grid;grid-template-columns:1fr 1fr;border:1px solid var(--line)}.quadrant-mini>div{height:110px;padding:16px;display:flex;justify-content:space-between;align-items:flex-start;font-weight:700}.quadrant-mini b{font-size:28px}.q1{background:var(--q1)}.q2{background:var(--q2)}.q3{background:var(--q3)}.q4{background:var(--q4)}.muted{color:var(--muted)}table{width:100%;border-collapse:collapse}th,td{border:1px solid #d7e0e8;padding:8px 9px;vertical-align:top}th{background:var(--blue);color:#fff;font-size:12px;text-align:left}tbody tr:nth-child(even){background:#f8fafc}.chip{display:inline-block;background:#e7f0f8;color:#174f7d;border-radius:12px;padding:2px 8px;font-size:11px;margin:1px}.badge{display:inline-block;border-radius:14px;padding:3px 9px;font-weight:700}.badge.qi{background:var(--q1)}.badge.qii{background:var(--q2)}.badge.qiii{background:var(--q3)}.badge.qiv{background:var(--q4)}.status{font-size:12px;font-weight:700;color:#345}.toolbar{display:flex;gap:8px;align-items:center;margin-bottom:12px}.toolbar .input:first-child{max-width:380px}.toolbar select{max-width:220px}.row-actions{white-space:nowrap}.icon-btn{border:0;background:#edf3f8;color:#174f7d;border-radius:5px;padding:5px 7px;margin:1px;font-size:12px}.icon-btn:hover{background:#dfeaf3}.obs{margin-top:4px;font-size:11px;color:var(--danger);font-weight:600}.drawer{position:fixed;top:88px;right:0;bottom:0;width:min(720px,92vw);background:#fff;z-index:30;box-shadow:-12px 0 30px rgba(0,0,0,.17);padding:22px;overflow:auto}.drawer.hidden{display:none}.drawer-head{border-bottom:1px solid var(--line);margin:-4px 0 18px;padding-bottom:10px}.drawer-head h2{margin:0}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:13px}.form-grid label{font-weight:600}.form-grid label .input{display:block;margin-top:5px;font-weight:400}.form-grid .wide{grid-column:1/-1}.form-grid.compact{margin-top:8px}.optional-box{background:#f7f9fb;border:1px dashed #bccad7;border-radius:7px;padding:12px}.check{display:block;padding:6px 2px;font-weight:400!important}.actions{display:flex;gap:8px;flex-wrap:wrap}.risk-map{width:100%;max-width:900px;display:block;margin:0 auto 18px}.gridline{stroke:#fff;stroke-width:.6;opacity:.7}.midline{stroke:#61788c;stroke-width:1.5}.q1fill{fill:var(--q1)}.q2fill{fill:var(--q2)}.q3fill{fill:var(--q3)}.q4fill{fill:var(--q4)}.risk-dot circle{fill:#0d416c;stroke:#fff;stroke-width:2}.risk-dot text{fill:#fff;font-size:12px;font-weight:700;pointer-events:none}.risk-map text{font-size:12px;fill:#30495e}.axislabel{font-weight:700;fill:#163c5f!important}.report-sheet{background:#fff;border:1px solid #ccd8e3;padding:18px;box-shadow:var(--shadow)}.report-head{display:grid;grid-template-columns:180px 1fr;align-items:center;border-bottom:5px solid var(--blue);padding-bottom:8px;margin-bottom:14px}.report-head img{width:160px;height:75px;object-fit:contain}.report-head>div{text-align:center;display:flex;flex-direction:column;gap:3px}.report-head strong{margin-top:6px;font-size:17px}.mar-table{font-size:11px}.footnote{font-size:11px;color:#556b7c}.follow-card{overflow:visible}.follow-title{display:flex;justify-content:space-between;gap:20px;margin-bottom:10px}.month-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:5px}.month-grid label{font-size:11px;text-align:center;color:var(--muted)}.month-grid .input{padding:6px 4px;text-align:center;margin-top:3px}.quarters{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:12px}.quarter{border:1px solid var(--line);border-radius:7px;padding:10px;display:flex;flex-direction:column;gap:4px}.quarter>b{color:var(--blue);font-size:16px}.quarter span,.quarter small{color:var(--muted)}.tabs{display:flex;gap:4px;margin-bottom:14px}.tab{border:1px solid var(--line);background:#fff;padding:9px 14px;border-radius:7px}.tab.active{background:var(--blue);color:#fff}.exercise-list{display:grid;gap:8px;margin-bottom:12px}.exercise-list>div,.record{border:1px solid var(--line);padding:10px;border-radius:7px;display:flex;gap:10px;flex-direction:column}.file-btn{display:inline-block;margin-top:8px;border:1px solid #c8d4df;background:#fff;padding:9px 14px;border-radius:7px;font-weight:600;cursor:pointer}.file-btn input{display:none}.empty{background:#fff;border:1px dashed #b9c7d4;padding:30px;border-radius:8px;text-align:center;color:var(--muted)}.login-page{min-height:100vh;background:linear-gradient(135deg,#062949 0%,#0b4d81 56%,#f3f6f9 56%,#f3f6f9 100%)}.login-wrap{min-height:100vh;display:grid;place-items:center;padding:30px}.login-card{width:min(420px,94vw);background:#fff;border-radius:14px;box-shadow:0 22px 60px rgba(0,0,0,.25);padding:30px}.login-logo{width:210px;display:block;margin:0 auto 18px}.login-card h1{text-align:center;color:var(--navy);font-size:25px;margin:0}.login-card>p{text-align:center;color:var(--muted);margin:6px 0 22px}.login-card form{display:grid;gap:13px}.login-card label{font-weight:600}.login-card label .input{margin-top:5px}.login-card details{margin-top:18px;color:var(--muted);font-size:12px}.error{min-height:18px;color:var(--danger);font-weight:600}@media(max-width:1000px){.kpis{grid-template-columns:repeat(3,1fr)}.grid-2{grid-template-columns:1fr}.area-cards{grid-template-columns:1fr}.month-grid{grid-template-columns:repeat(6,1fr)}.quarters{grid-template-columns:repeat(2,1fr)}.brand div{display:none}.top-actions .userbox{display:none}}@media(max-width:720px){.layout{grid-template-columns:70px 1fr}.nav-link span,.side-footer{display:none}.nav-link{justify-content:center}.content{padding:14px}.topbar{padding:8px 12px;height:72px}.brand img{width:145px;height:54px}.drawer{top:72px}.kpis{grid-template-columns:repeat(2,1fr)}.page-head{flex-direction:column}.head-actions{width:100%;flex-wrap:wrap}.form-grid{grid-template-columns:1fr}.form-grid .wide{grid-column:auto}.month-grid{grid-template-columns:repeat(3,1fr)}.quarters{grid-template-columns:1fr}}@media print{body{background:#fff}.topbar,.sidebar,.page-head.no-print,.no-print,.btn,.toolbar,.tabs{display:none!important}.layout{display:block}.content{padding:0}.report-sheet{border:0;box-shadow:none;padding:0}.report-head{margin-top:0}.panel{box-shadow:none;border:0}.risk-map{max-height:520px}.mar-table{font-size:9px}thead{display:table-header-group}tr{break-inside:avoid}.footnote{position:fixed;bottom:0}@page{size:landscape;margin:10mm}}
.institutional-kpis{grid-template-columns:repeat(4,minmax(150px,1fr))}.institutional-map-svg .inst-dot{cursor:pointer}.institutional-map-svg .inst-dot:hover circle{fill:#2d75b8;stroke:#092e55;stroke-width:3}.detail-stack{display:grid;gap:14px}.detail-stack section{border:1px solid var(--line);border-radius:8px;padding:12px}.detail-stack p{margin:6px 0}.detail-grid{display:grid!important;grid-template-columns:repeat(4,1fr);gap:8px}.detail-grid>div{background:#f5f8fb;padding:10px;border-radius:7px;display:flex;flex-direction:column}.detail-grid span{font-size:11px;color:var(--muted)}.detail-grid b{font-size:20px;color:var(--blue)}.source-list{display:grid;gap:7px}.source-link{border:1px solid var(--line);background:#f8fbfd;border-radius:7px;padding:9px;text-align:left;display:grid;gap:2px;color:var(--text)}.source-link span,.source-link small{color:var(--muted)}.source-link:hover{border-color:#70a2ca;background:#eef6fb}.source-evidence{border-top:1px dashed var(--line);padding:9px 0}.source-evidence:first-child{border-top:0}.linklike{border:0;background:transparent;padding:0;color:#1f5f95;text-decoration:underline;font-weight:700}.suggestion-grid{display:grid;grid-template-columns:repeat(2,minmax(280px,1fr));gap:10px}.suggestion-card{border:1px solid var(--line);background:#fafcfe;border-radius:8px;padding:12px}.suggestion-card>div{display:flex;justify-content:space-between;gap:12px}.suggestion-card>div span{color:var(--muted)}.relation-graph{width:100%;max-width:820px;display:block;margin:auto}.relation-line{stroke:#a8bdcf;stroke-width:2}.relation-center circle{fill:#b88b20;stroke:#fff;stroke-width:4}.relation-center text{fill:#fff;font-weight:700;font-size:16px}.relation-node{cursor:pointer}.relation-node circle{fill:#1f4e78;stroke:#fff;stroke-width:3}.relation-node:hover circle{fill:#2d75b8}.relation-node text{fill:#fff;font-weight:700;font-size:12px}.relation-node .small,.relation-center .small{font-size:10px;font-weight:400}@media(max-width:900px){.institutional-kpis{grid-template-columns:repeat(2,1fr)}.detail-grid{grid-template-columns:repeat(2,1fr)}.suggestion-grid{grid-template-columns:1fr}}

/* MAR_V52_FORMATO1_UNA_HOJA */
@media print{
  .format1-sheet{width:100%;height:auto;page-break-inside:avoid!important;break-inside:avoid-page!important;overflow:visible!important;padding:4mm!important;border:0!important;box-shadow:none!important}
  .format1-sheet .report-head{grid-template-columns:38mm 1fr;margin-bottom:2mm;padding-bottom:2mm;border-bottom-width:2px}
  .format1-sheet .report-head img{width:34mm;height:15mm}
  .format1-sheet .report-head b{font-size:10pt}.format1-sheet .report-head span{font-size:8pt}.format1-sheet .report-head strong{font-size:11pt;margin-top:1mm}
  .format1-sheet .risk-map{width:100%!important;height:102mm!important;max-height:102mm!important;margin:0 auto 2mm!important}
  .format1-sheet table{font-size:7.2pt!important;line-height:1.08!important;table-layout:fixed!important}
  .format1-sheet th,.format1-sheet td{padding:1.2mm 1.5mm!important}
  .format1-sheet th:nth-child(1),.format1-sheet td:nth-child(1){width:8%}
  .format1-sheet th:nth-child(2),.format1-sheet td:nth-child(2){width:56%}
  .format1-sheet th:nth-child(3),.format1-sheet td:nth-child(3),.format1-sheet th:nth-child(4),.format1-sheet td:nth-child(4){width:11%}
  .format1-sheet th:nth-child(5),.format1-sheet td:nth-child(5){width:14%}
  @page{size:A4 landscape;margin:6mm}
}
